{
    "meta": {
      "name": "Employee Credential",
      "memo": "Verifiable employment identity credential issued by an organisation to an employee confirming employment status and role",
      "domain": "Work",
      "code": 7,
      "format": "W3C-VC-2.0",
      "sort": 1,
      "version": "1.0",
      "type": "EmployeeCredential"
    },
    "features": {
      "edit": false,
      "transfer": false,
      "burn": true,
      "revoke": true,
      "renew": true,
      "duration": 365
    },
    "schema": "7c101635120b03e4cb2ba5ac7bdced5d",
    "item": "c97de79c20969321d10795ae61b4ec03",
    "active": true,
    "created": 1717228200000,
    "validation": {
      "strict": true,
      "rejectUnknownFields": true,
      "trimStrings": true,
      "allowEmptyOptionalFields": true
    },
    "issuance": {
      "generateCredentialId": true,
      "generateTokenId": true,
      "signCredential": true,
      "persistCredential": true
    },
    "cred": {
      "@context": [
        "https://www.w3.org/ns/credentials/v2",
        "https://schema.org",
        "https://nuvowallet.com/credentials/context/v01"
      ],
      "id": "https://nuvowallet.com/credentials/{{credential_id}}",
      "type": ["VerifiableCredential", "EmployeeCredential"],
      "name": "Employee Credential",
      "description": "Verifiable employment identity credential",
      "issuer": {
        "id": "https://nuvowallet.com/user/{{nuvowallet_id_issuer}}",
        "nuvowalletId": "{{nuvowallet_id_issuer}}",
        "name": "{{issuer_name}}"
      },
      "broker": {
        "id": "{{broker_id_url_or_blank}}",
        "nuvowalletId": "{{nuvowallet_id_broker}}",
        "name": "{{broker_name_or_blank}}"
      },
      "verifier": {
        "id": "{{verifier_id_url_or_blank}}",
        "nuvowalletId": "{{nuvowallet_id_verifier}}",
        "name": "{{verifier_name_or_blank}}"
      },
      "validFrom": "{{validFrom}}",
      "validUntil": "{{validUntil}}",
      "credentialSubject": {
        "id": "https://nuvowallet.com/user/{{nuvowallet_id_user}}",
        "nuvowalletId": "{{nuvowallet_id_user}}",
        "name": "{{name}}",
        "identifier": "{{employee_id}}",
        "employeeId": "{{employee_id}}",
        "jobTitle": "{{jobTitle}}",
        "employmentType": "{{employmentType}}",
        "worksFor": {
          "id": "https://nuvowallet.com/user/{{nuvowallet_id_issuer}}",
          "type": "Organization",
          "name": "{{issuer_name}}",
          "nuvowalletId": "{{nuvowallet_id_issuer}}"
        },
        "startDate": "{{startDate}}",
        "endDate": "{{endDate}}",
        "workLocation": {
          "type": "Place",
          "address": "https://nuvowallet.com/user/{{nuvowallet_id_issuer}}/address"
        },
        "workArrangement": "{{workArrangement}}",
        "email": "{{email}}",
        "telephone": "{{telephone}}",
        "image": "https://nuvowallet.com/files/{{image_file_id}}"
      },
      "credentialStatus": {
        "id": "https://nuvowallet.com/credentials/{{credential_id}}/status",
        "type": "NuvoRevocationStatus"
      },
      "credentialSchema": {
        "id": "https://nuvowallet.com/schemas/7c101635120b03e4cb2ba5ac7bdced5d",
        "type": "JsonSchema"
      },
      "proof": {
        "type": "DataIntegrityProof",
        "cryptosuite": "ecdsa-rdfc-2019",
        "created": "{{proof_created}}",
        "verificationMethod": "https://nuvowallet.com/user/{{nuvowallet_id_issuer}}#key-1",
        "proofPurpose": "assertionMethod",
        "proofValue": "{{proof_value}}"
      }
    },
    "data": [
      {
        "name": "name",
        "path": "credentialSubject.name",
        "label": "Full Name",
        "mime": "text",
        "mandatory": true,
        "description": "Full legal name of the employee",
        "validation": {
          "minLength": 2,
          "maxLength": 100,
          "pattern": "^[A-Za-z .'-]+$"
        }
      },
      {
        "name": "employeeId",
        "path": "credentialSubject.employeeId",
        "label": "Employee ID",
        "mime": "text",
        "mandatory": true,
        "description": "Unique employee identification number assigned by the organisation",
        "validation": {
          "minLength": 2,
          "maxLength": 50,
          "pattern": "^[A-Za-z0-9._/-]+$"
        }
      },
      {
        "name": "jobTitle",
        "path": "credentialSubject.jobTitle",
        "label": "Job Title",
        "mime": "text",
        "mandatory": true,
        "description": "Official job title of the employee",
        "validation": {
          "minLength": 2,
          "maxLength": 100
        }
      },
      {
        "name": "employmentType",
        "path": "credentialSubject.employmentType",
        "label": "Employment Type",
        "mime": "enum",
        "mandatory": true,
        "description": "Nature of the employment engagement",
        "options": ["FULL_TIME", "PART_TIME", "CONTRACTOR", "TEMPORARY", "INTERN"]
      },
      {
        "name": "startDate",
        "path": "credentialSubject.startDate",
        "label": "Employment Start Date",
        "mime": "date",
        "mandatory": true,
        "description": "Date the employee commenced employment",
        "validation": {
          "format": "YYYY-MM-DD",
          "mustBePast": true
        }
      },
      {
        "name": "endDate",
        "path": "credentialSubject.endDate",
        "label": "Employment End Date",
        "mime": "date",
        "mandatory": true,
        "description": "Date the employment ends",
        "validation": {
          "format": "YYYY-MM-DD"
        }
      },
      {
        "name": "workArrangement",
        "path": "credentialSubject.workArrangement",
        "label": "Work Arrangement",
        "mime": "enum",
        "mandatory": false,
        "default": "",
        "description": "Physical work arrangement of the employee",
        "options": ["on_site", "remote", "hybrid", ""]
      },
      {
        "name": "email",
        "path": "credentialSubject.email",
        "label": "Work Email",
        "mime": "text",
        "mandatory": false,
        "default": "",
        "description": "Official work email address of the employee",
        "validation": {
          "format": "email",
          "maxLength": 254
        }
      },
      {
        "name": "telephone",
        "path": "credentialSubject.telephone",
        "label": "Work Phone",
        "mime": "text",
        "mandatory": false,
        "default": "",
        "description": "Official work phone number in E.164 format",
        "validation": {
          "format": "e164"
        }
      },
      {
        "name": "image_file_id",
        "path": "credentialSubject.image",
        "label": "User Photograph",
        "mime": "file/image",
        "mandatory": true,
        "description": "User Photograph",
        "validation": {
          "maxSizeMB": 3,
          "allowedMimeTypes": ["image/jpeg", "image/png"]
        }
      },
      {
        "name": "broker_id",
        "path": "broker.nuvowalletId",
        "label": "Broker NUVOWallet ID",
        "mime": "text",
        "mandatory": false,
        "default": "",
        "description": "Broker NUVOWallet ID",
        "validation": {
          "maxLength": 100
        }
      },
      {
        "name": "broker_name",
        "path": "broker.name",
        "label": "Broker Name",
        "mime": "text",
        "mandatory": false,
        "default": "",
        "description": "Broker Name",
        "validation": {
          "maxLength": 150
        }
      },
      {
        "name": "verifier_id",
        "path": "verifier.nuvowalletId",
        "label": "Verifier NUVOWallet ID",
        "mime": "text",
        "mandatory": false,
        "default": "",
        "description": "Verifier NUVOWallet ID",
        "validation": {
          "maxLength": 100
        }
      },
      {
        "name": "verifier_name",
        "path": "verifier.name",
        "label": "Verifier Name",
        "mime": "text",
        "mandatory": false,
        "default": "",
        "description": "Verifier Name",
        "validation": {
          "maxLength": 150
        }
      }
    ]
  }
