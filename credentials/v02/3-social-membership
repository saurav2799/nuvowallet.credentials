{
    "meta": {
      "name": "Membership Credential",
      "memo": "Verifiable membership credential issued by an organisation, association, club, community, platform, or institution to confirm membership status and tier",
      "domain": "Membership",
      "code": 3,
      "format": "W3C-VC-2.0",
      "sort": 2,
      "version": "1.0",
      "type": "MembershipCredential"
    },
    "features": {
      "edit": true,
      "transfer": true,
      "burn": true,
      "revoke": true,
      "renew": true,
      "duration": 365
    },
    "schema": "3aee0b2ea2cbc9e14072b07a67900e7b",
    "item": "9311920b20dcb1d1ee96ed6914c3ea5d",
    "active": true,
    "created": 1717228200000,
    "validation": {
      "strict": true,
      "rejectUnknownFields": true,
      "trimStrings": true,
      "allowEmptyOptionalFields": true
    },
    "issuance": {
      "generateCredentialId": true,
      "generateTokenId": true,
      "signCredential": true,
      "persistCredential": true
    },
    "cred": {
      "@context": [
        "https://www.w3.org/ns/credentials/v2",
        "https://schema.org",
        "https://nuvowallet.com/credentials/context/v01"
      ],
      "id": "https://nuvowallet.com/credentials/{{credential_id}}",
      "type": ["VerifiableCredential", "MembershipCredential"],
      "name": "Membership Credential",
      "description": "Verifiable membership credential",
      "issuer": {
        "id": "https://nuvowallet.com/user/{{nuvowallet_id_issuer}}",
        "nuvowalletId": "{{nuvowallet_id_issuer}}",
        "name": "{{issuer_name}}"
      },
      "broker": {
        "id": "{{broker_id_url_or_blank}}",
        "nuvowalletId": "{{nuvowallet_id_broker}}",
        "name": "{{broker_name_or_blank}}"
      },
      "verifier": {
        "id": "{{verifier_id_url_or_blank}}",
        "nuvowalletId": "{{nuvowallet_id_verifier}}",
        "name": "{{verifier_name_or_blank}}"
      },
      "validFrom": "{{validFrom}}",
      "validUntil": "{{validUntil}}",
      "credentialSubject": {
        "id": "https://nuvowallet.com/user/{{nuvowallet_id_user}}",
        "nuvowalletId": "{{nuvowallet_id_user}}",
        "name": "{{name}}",
        "identifier": "{{membership_id}}",
        "membershipId": "{{membership_id}}",
        "memberOf": {
          "id": "https://nuvowallet.com/user/{{nuvowallet_id_issuer}}",
          "type": "Organization",
          "name": "{{issuer_name}}",
          "nuvowalletId": "{{nuvowallet_id_issuer}}"
        },
        "membershipType": "{{membershipType}}",
        "membershipTier": "{{membershipTier}}",
        "membershipStatus": "{{membershipStatus}}",
        "startDate": "{{startDate}}",
        "endDate": "{{endDate}}",
        "email": "{{email}}",
        "telephone": "{{telephone}}",
        "image": "https://nuvowallet.com/files/{{image_file_id}}"
      },
      "credentialStatus": {
        "id": "https://nuvowallet.com/credentials/{{credential_id}}/status",
        "type": "NuvoRevocationStatus"
      },
      "credentialSchema": {
        "id": "https://nuvowallet.com/schemas/3aee0b2ea2cbc9e14072b07a67900e7b",
        "type": "JsonSchema"
      },
      "proof": {
        "type": "DataIntegrityProof",
        "cryptosuite": "ecdsa-rdfc-2019",
        "created": "{{proof_created}}",
        "verificationMethod": "https://nuvowallet.com/user/{{nuvowallet_id_issuer}}#key-1",
        "proofPurpose": "assertionMethod",
        "proofValue": "{{proof_value}}"
      }
    },
    "data": [
      {
        "name": "name",
        "path": "credentialSubject.name",
        "label": "Full Name",
        "mime": "text",
        "mandatory": true,
        "description": "Full legal or registered name of the member",
        "validation": {
          "minLength": 2,
          "maxLength": 100,
          "pattern": "^[A-Za-z .'-]+$"
        }
      },
      {
        "name": "membershipId",
        "path": "credentialSubject.membershipId",
        "label": "Membership ID",
        "mime": "text",
        "mandatory": true,
        "description": "Unique membership ID or card number assigned by the issuing organisation",
        "validation": {
          "minLength": 2,
          "maxLength": 50,
          "pattern": "^[A-Za-z0-9._/-]+$"
        }
      },
      {
        "name": "membershipType",
        "path": "credentialSubject.membershipType",
        "label": "Membership Type",
        "mime": "enum",
        "mandatory": true,
        "description": "Category of membership",
        "options": [
          "INDIVIDUAL",
          "ORGANIZATION",
          "STUDENT",
          "PROFESSIONAL",
          "COMMUNITY",
          "LIFETIME"
        ]
      },
      {
        "name": "membershipTier",
        "path": "credentialSubject.membershipTier",
        "label": "Membership Tier",
        "mime": "enum",
        "mandatory": false,
        "default": "",
        "description": "Membership tier or level",
        "options": [
          "BASIC",
          "SILVER",
          "GOLD",
          "PLATINUM",
          "PREMIUM",
          "LIFETIME",
          ""
        ]
      },
      {
        "name": "membershipStatus",
        "path": "credentialSubject.membershipStatus",
        "label": "Membership Status",
        "mime": "enum",
        "mandatory": true,
        "description": "Current membership status",
        "options": [
          "ACTIVE",
          "INACTIVE",
          "SUSPENDED",
          "EXPIRED"
        ]
      },
      {
        "name": "startDate",
        "path": "credentialSubject.startDate",
        "label": "Start Date",
        "mime": "date",
        "mandatory": true,
        "description": "Date the member started their membership",
        "validation": {
          "format": "YYYY-MM-DD",
          "mustBePast": true
        }
      },
      {
        "name": "endDate",
        "path": "credentialSubject.endDate",
        "label": "End Date",
        "mime": "date",
        "mandatory": true,
        "description": "Date the member's membership ends",
        "validation": {
          "format": "YYYY-MM-DD"
        }
      },
      {
        "name": "email",
        "path": "credentialSubject.email",
        "label": "Member Email",
        "mime": "text",
        "mandatory": false,
        "default": "",
        "description": "Official or registered member email address",
        "validation": {
          "format": "email",
          "maxLength": 254
        }
      },
      {
        "name": "telephone",
        "path": "credentialSubject.telephone",
        "label": "Member Phone",
        "mime": "text",
        "mandatory": false,
        "default": "",
        "description": "Registered member phone number in E.164 format",
        "validation": {
          "format": "e164"
        }
      },
      {
        "name": "image_file_id",
        "path": "credentialSubject.image",
        "label": "Member Photograph",
        "mime": "file/image",
        "mandatory": false,
        "default": "",
        "description": "Optional member photograph stored as a NuvoWallet file reference",
        "validation": {
          "maxSizeMB": 3,
          "allowedMimeTypes": ["image/jpeg", "image/png"]
        }
      }
    ]
  }
